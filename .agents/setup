#!/usr/bin/env bash
# Copyright 2026 Spunky Tensor
# SPDX-License-Identifier: Apache-2.0

# Prepare the CPU development/test toolchain. Model weights and CUDA inference
# deliberately stay out of the snapshot; they require an explicit GPU workflow.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
node_version="22.22.0"
node_dir="$HOME/.local/lib/node-v${node_version}-linux-x64"
node_bin="$node_dir/bin"

log_step() {
  printf '\n==> %s\n' "$1"
}

run_as_root() {
  if [[ "$(id -u)" -eq 0 ]]; then
    "$@"
  else
    sudo -n "$@"
  fi
}

log_step "Installing system media and browser dependencies"
missing_packages=()
for package in ffmpeg chromium; do
  dpkg-query --show --showformat='${db:Status-Status}' "$package" 2>/dev/null | grep -qx installed || missing_packages+=("$package")
done
if (( ${#missing_packages[@]} )); then
  run_as_root apt-get update
  run_as_root apt-get install -y --no-install-recommends "${missing_packages[@]}"
fi

log_step "Installing Node.js ${node_version}"
if [[ ! -x "$node_bin/node" ]]; then
  archive="node-v${node_version}-linux-x64.tar.xz"
  download_dir="$(mktemp -d)"
  trap 'rm -rf "$download_dir"' EXIT
  curl --fail --location --silent --show-error "https://nodejs.org/dist/v${node_version}/SHASUMS256.txt" -o "$download_dir/SHASUMS256.txt"
  curl --fail --location --silent --show-error "https://nodejs.org/dist/v${node_version}/${archive}" -o "$download_dir/$archive"
  (cd "$download_dir" && grep "  ${archive}$" SHASUMS256.txt | sha256sum --check --status)
  mkdir -p "$(dirname "$node_dir")"
  tar -xJf "$download_dir/$archive" -C "$(dirname "$node_dir")"
fi

log_step "Installing Python 3.12 CPU test environment"
uv python install 3.12
uv venv --python 3.12 --allow-existing "$repo_root/.venv-ci"
uv pip install --python "$repo_root/.venv-ci/bin/python" --requirement "$repo_root/ci/requirements.txt"

log_step "Installing locked browser test dependencies"
PATH="$node_bin:$PATH" npm ci --prefix "$repo_root"

log_step "Configuring repository login-shell environment"
profile_marker="# reel-video orb development environment"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<EOF

$profile_marker
if [[ -z "\${REEL_VIDEO_ORB_PROFILE:-}" && "\${PWD}" == "$repo_root"* ]]; then
  export REEL_VIDEO_ORB_PROFILE=1
  export PATH="$repo_root/.venv-ci/bin:$node_bin:\$PATH"
  export CHROMIUM_PATH="\$(command -v chromium)"
fi
EOF
fi

log_step "Orb setup complete"
