# Copy to .env and replace with a unique secret (at least 32 ASCII characters).
# Generate a secure 32-character key with: openssl rand -hex 16
# Paste the output as REEL_VIDEO_API_TOKEN below in your local .env; keep it private.
REEL_VIDEO_API_TOKEN=replace-with-your-own-secret-of-at-least-32-characters
# HF_TOKEN=
# REEL_VIDEO_NETWORK_HOSTS=gpu.example.internal
# REEL_VIDEO_PORT=8088
# REEL_VIDEO_CONTAINER_NAME=reel-video

# Completed-video retention (days) and media storage quota (GiB).
# REEL_VIDEO_RETENTION_DAYS=3
# REEL_VIDEO_QUOTA_GIB=25
